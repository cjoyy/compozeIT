# CompozeIT — Environment Variables
# Copy this file to .env.local and fill in the values

# AI Provider
AI_PROVIDER=ollama              # ollama | gemini
OLLAMA_TUNNEL_URL=              # URL dari cloudflared tunnel, contoh: https://xxxx.trycloudflare.com
GEMINI_API_KEY=                 # fallback provider (get from https://aistudio.google.com)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=       # Your Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Your Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY=      # Your Supabase service role key (server-side only)
